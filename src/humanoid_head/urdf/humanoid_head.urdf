<?xml version="1.0"?>
<robot name="humanoid_head">

  <!-- Materials -->
  <material name="skin">
    <color rgba="0.95 0.78 0.65 1.0"/>
  </material>
  <material name="jaw_color">
    <color rgba="0.78 0.58 0.45 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="pink">
    <color rgba="0.9 0.55 0.5 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.4 0.4 0.45 1.0"/>
  </material>

  <!-- Base pedestal -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Head sphere -->
  <link name="head_link">
    <visual>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0015" iyy="0.0015" izz="0.0015" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Left eyeball -->
  <link name="left_eyeball_link">
    <visual>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.002"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_eyeball_joint" type="fixed">
    <parent link="head_link"/>
    <child link="left_eyeball_link"/>
    <origin xyz="0.10 0.035 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Left pupil -->
  <link name="left_pupil_link">
    <visual>
      <geometry>
        <sphere radius="0.009"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.0005"/>
      <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_pupil_joint" type="fixed">
    <parent link="head_link"/>
    <child link="left_pupil_link"/>
    <origin xyz="0.118 0.035 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Right eyeball -->
  <link name="right_eyeball_link">
    <visual>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.002"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_eyeball_joint" type="fixed">
    <parent link="head_link"/>
    <child link="right_eyeball_link"/>
    <origin xyz="0.10 -0.035 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Right pupil -->
  <link name="right_pupil_link">
    <visual>
      <geometry>
        <sphere radius="0.009"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.0005"/>
      <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_pupil_joint" type="fixed">
    <parent link="head_link"/>
    <child link="right_pupil_link"/>
    <origin xyz="0.118 -0.035 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Left eyelid -->
  <link name="left_eyelid_link">
    <visual>
      <geometry>
        <box size="0.045 0.02 0.005"/>
      </geometry>
      <origin xyz="-0.01 0 -0.012" rpy="0 0 0"/>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.045 0.02 0.005"/>
      </geometry>
      <origin xyz="-0.01 0 -0.012" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="1e-7" iyy="5e-7" izz="5e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_eyelid_joint" type="revolute">
    <parent link="head_link"/>
    <child link="left_eyelid_link"/>
    <origin xyz="0.105 0.035 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.1" upper="1.57" effort="0.5" velocity="10"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Right eyelid -->
  <link name="right_eyelid_link">
    <visual>
      <geometry>
        <box size="0.045 0.02 0.005"/>
      </geometry>
      <origin xyz="-0.01 0 -0.012" rpy="0 0 0"/>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.045 0.02 0.005"/>
      </geometry>
      <origin xyz="-0.01 0 -0.012" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="1e-7" iyy="5e-7" izz="5e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_eyelid_joint" type="revolute">
    <parent link="head_link"/>
    <child link="right_eyelid_link"/>
    <origin xyz="0.105 -0.035 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.1" upper="1.57" effort="0.5" velocity="10"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Jaw -->
  <link name="jaw_link">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.015"/>
      </geometry>
      <origin xyz="0.005 0 -0.01" rpy="0 0 0"/>
      <material name="jaw_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.04 0.015"/>
      </geometry>
      <origin xyz="0.005 0 -0.01" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-5" iyy="5e-6" izz="5e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="jaw_joint" type="revolute">
    <parent link="head_link"/>
    <child link="jaw_link"/>
    <origin xyz="0.10 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.5" effort="1.0" velocity="5"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- Left smile corner -->
  <link name="left_smile_link">
    <visual>
      <geometry>
        <box size="0.025 0.006 0.004"/>
      </geometry>
      <material name="pink"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.006 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_smile_joint" type="revolute">
    <parent link="head_link"/>
    <child link="left_smile_link"/>
    <origin xyz="0.10 0.022 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="0.3" velocity="5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- Right smile corner -->
  <link name="right_smile_link">
    <visual>
      <geometry>
        <box size="0.025 0.006 0.004"/>
      </geometry>
      <material name="pink"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.006 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_smile_joint" type="revolute">
    <parent link="head_link"/>
    <child link="right_smile_link"/>
    <origin xyz="0.10 -0.022 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.3" effort="0.3" velocity="5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- Joint state publisher: publishes all joint states to /joint_states -->
  <gazebo>
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_state_publisher">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>100</update_rate>
      <joint_name>left_eyelid_joint</joint_name>
      <joint_name>right_eyelid_joint</joint_name>
      <joint_name>jaw_joint</joint_name>
      <joint_name>left_smile_joint</joint_name>
      <joint_name>right_smile_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
